{
  "version": "1.0",
  "scoring": {
    "pass_threshold": 7,
    "max_iterations": 5,
    "score_method": "min_of_5",
    "security_thresholds": {
      "critical": 7,
      "standard": 5,
      "low": 3
    }
  },
  "hotfix": {
    "max_files": 3,
    "consecutive_limit": 3,
    "allowed_security_tiers": ["low", "standard"]
  },
  "agent_comms": {
    "max_files_per_type": 10,
    "archive_enabled": true
  },
  "firewall": {
    "_comment": "auto_allow=true 이면 pre-bash-firewall.sh가 읽기 전용/저위험 명령을 무프롬프트로 자동 허용(permissionDecision:allow). deny/ask 위험 차단 계층은 이 값과 무관하게 항상 실행된다(false로 꺼도 가드 유지).",
    "auto_allow": true
  }
}
