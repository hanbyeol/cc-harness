{
  "profile": "sdlc",
  "base_branch": "main",
  "integration_branch": "harness/integration",
  "protected_branches": [
    "main"
  ],
  "verify": {
    "commands": [
      "node --test --test-concurrency={verify_cpus} \"test/**/*.test.mjs\"",
      "node bin/harness.mjs lint-contract"
    ],
    "test_count": "from:commands[0]"
  },
  "threshold": 7,
  "max_rounds": 3,
  "budget": {
    "step_timeout_sec": 5400
  },
  "roles": {
    "builder": {
      "adapter": "claude",
      "model": "claude-sonnet-5-5",
      "effort_by_tier": {
        "standard": "medium",
        "critical": "high"
      },
      "effort_escalate": "high"
    },
    "evaluator": {
      "adapter": "claude",
      "model": "claude-sonnet-5-5",
      "by_tier": {
        "critical": "claude-opus-5-5",
        "standard": "claude-opus-5-5"
      },
      "effort_by_tier": {
        "standard": "high",
        "critical": "high"
      }
    },
    "security-reviewer": {
      "adapter": "claude",
      "model": "claude-opus-5-5",
      "effort_by_tier": {
        "critical": "high"
      }
    }
  },
  "run": {
    "context_files": [
      "docs/MAP.md"
    ]
  }
}
